<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="App logo"
        android:scaleType="centerInside"
        android:src="@drawable/header_logo" />

    <Button
        android:id="@+id/btn_select_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Images" />

    <Button
        android:id="@+id/btn_select_videos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Select Videos" />

    <Button
        android:id="@+id/btn_clear_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clear Selection" />

    <Button
        android:id="@+id/btn_png_to_jpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="PNG -> JPG" />

    <TextView
        android:id="@+id/tv_selected_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Selected images: 0"
        android:textSize="16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_selected_images"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_set_exif_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Set EXIF Date"
        android:enabled="false" />

    <Button
        android:id="@+id/btn_fix_gallery_ghosts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Fix Gallery Ghosts"
        android:enabled="false" />

</LinearLayout>
